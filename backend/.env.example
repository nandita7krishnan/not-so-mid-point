# Google Maps Platform key with Geocoding, Directions, Distance Matrix and
# Places API (New) enabled.
GOOGLE_MAPS_API_KEY=

# Optional. Without it, free-text preference interpretation (Node D) and the
# generated "why this spot" copy (Node F) fall back to deterministic logic.
ANTHROPIC_API_KEY=

# Records every search to backend/evals/log/ as eval input. Off by default,
# because it is the only thing the app writes that derives from a visitor's
# starting point. Records are coarsened before they are written: no typed
# address, no participant names, a start named by the nearest of ~50 seeded
# neighbourhoods, coordinates rounded to ~1.1 km.
# SEARCH_LOG_ENABLED=true

# Public anchor file, built by `python -m evals.fetch_anchors`. When it exists,
# a logged start is named by the nearest transit stop instead of the
# neighbourhood, and carries the stop's own published coordinate. Absent, the
# neighbourhood snap is what runs.
# SEARCH_LOG_ANCHORS=data/anchors.csv

# Optional overrides
# LLM_MODEL=claude-opus-5
# SEARCH_LOG_COORD_PRECISION=2
# SEARCH_LOG_ANCHOR_RADIUS_M=500
# SEARCH_LOG_ANCHOR_MIN_NEIGHBOURS=3
# MAX_CANDIDATE_NEIGHBOURHOODS=8
# CACHE_TTL_SECONDS=86400
# FAIRNESS_CEILING_K=0.4
